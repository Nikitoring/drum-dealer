# PostgreSQL (used by Docker Compose and Prisma)
POSTGRES_DB=drum_dealer
POSTGRES_USER=drum_dealer
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://drum_dealer:change-me@localhost:5432/drum_dealer?schema=public

# Backend
BACKEND_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Yandex Object Storage (S3-compatible API)
S3_BUCKET=replace-with-yandex-bucket-name
S3_ACCESS_KEY=replace-with-static-access-key
S3_SECRET_KEY=replace-with-static-secret-key
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_FORCE_PATH_STYLE=true
# For a public bucket this can remain the default endpoint.
S3_PUBLIC_URL=https://storage.yandexcloud.net

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
