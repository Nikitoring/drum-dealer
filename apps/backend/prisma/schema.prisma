generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCondition {
  NEW
  USED
}

enum ProductStatus {
  AVAILABLE
  SOLD
  HIDDEN
}

enum TimeSlotStatus {
  AVAILABLE
  PENDING
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum RehearsalPointImageType {
  POINT
  EQUIPMENT
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model Product {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  slug           String            @unique
  brandId        String           @db.Uuid
  categoryId     String            @db.Uuid
  price          Decimal           @db.Decimal(12, 2)
  condition      ProductCondition
  status         ProductStatus     @default(AVAILABLE)
  description    String?           @db.Text
  specifications Json?             @db.JsonB
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@index([categoryId, brandId, condition])
  @@index([status, createdAt])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([productId, position])
}

model RehearsalPoint {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  slug         String     @unique
  address      String
  description  String?    @db.Text
  equipment    String?    @db.Text
  images       RehearsalPointImage[]
  contactPhone String?
  pricePerHour Decimal?   @db.Decimal(12, 2)
  slots        TimeSlot[]
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
}

model RehearsalPointImage {
  id               String                  @id @default(uuid()) @db.Uuid
  rehearsalPointId String                  @db.Uuid
  url              String
  type             RehearsalPointImageType @default(POINT)
  position         Int                     @default(0)
  rehearsalPoint   RehearsalPoint           @relation(fields: [rehearsalPointId], references: [id], onDelete: Cascade)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)

  @@index([rehearsalPointId, type, position])
}

model TimeSlot {
  id               String          @id @default(uuid()) @db.Uuid
  rehearsalPointId String          @db.Uuid
  startAt          DateTime        @db.Timestamptz(3)
  endAt            DateTime        @db.Timestamptz(3)
  status           TimeSlotStatus  @default(AVAILABLE)
  rehearsalPoint   RehearsalPoint  @relation(fields: [rehearsalPointId], references: [id], onDelete: Restrict)
  bookings         RehearsalBooking[]
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([rehearsalPointId, startAt])
  @@index([rehearsalPointId, startAt, status])
}

model RehearsalBooking {
  id            String        @id @default(uuid()) @db.Uuid
  timeSlotId    String        @db.Uuid
  customerName  String
  customerPhone String
  customerEmail String?
  comment       String?       @db.Text
  personalDataConsent Boolean
  status        BookingStatus @default(PENDING)
  timeSlot      TimeSlot      @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([timeSlotId, status])
  @@index([status, createdAt])
}
