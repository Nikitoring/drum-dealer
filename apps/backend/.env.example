DATABASE_URL=postgresql://drum_dealer:change-me@localhost:5434/drum_dealer?schema=public

# Yandex Object Storage (S3-compatible API)
S3_BUCKET=replace-with-yandex-bucket-name
S3_ACCESS_KEY=replace-with-static-access-key
S3_SECRET_KEY=replace-with-static-secret-key
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_FORCE_PATH_STYLE=true
# For a public bucket this can remain the default endpoint.
S3_PUBLIC_URL=https://storage.yandexcloud.net
